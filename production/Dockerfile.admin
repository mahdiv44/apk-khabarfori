FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY components ./components
COPY hooks ./hooks
COPY lib ./lib
COPY public ./public
COPY vendor ./vendor
COPY app ./app
COPY production ./production
COPY scripts/prepare-next-admin.mjs ./scripts/prepare-next-admin.mjs
COPY tsconfig.json ./tsconfig.json
RUN node scripts/prepare-next-admin.mjs
RUN npm --prefix apps/admin run build
FROM node:22-bookworm-slim
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
WORKDIR /app
COPY --from=build --chown=node:node /app/apps/admin/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=build --chown=node:node /app/apps/admin/public ./apps/admin/public
USER node
EXPOSE 3000
CMD ["node","apps/admin/server.js"]
